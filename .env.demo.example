# Modelo del .env de la demo, que va en la carpeta de la demo en la PC. El .env nunca se manda por chat ni por mail.
# Una clave larga al azar para la base (docs/10-demo-en-pc.md la genera en la PC)
POSTGRES_PASSWORD=
# Otra clave larga al azar, distinta de la anterior
PAYLOAD_SECRET=
# El token del túnel: se copia de Cloudflare y se pega solo acá
TUNNEL_TOKEN=
NEXT_PUBLIC_SITE_URL=https://visionfm-labs-staging.fraybentos.uy
